# .env.example
# -------------
# Copy this file to .env and fill in the values before running the platform.
# NEVER commit the real .env file to source control.
#
# cp .env.example .env

# ── PostgreSQL ─────────────────────────────────────────────────────────────────

# Name of the database to create / connect to
POSTGRES_DB=platform_db

# Database superuser username
POSTGRES_USER=platform_user

# Database superuser password — CHANGE THIS before deploying to any shared env
POSTGRES_PASSWORD=platform_pass

# Host port to bind PostgreSQL to on the Docker host (default: 5432)
POSTGRES_PORT=5432

# ── Backend ────────────────────────────────────────────────────────────────────

# Full async SQLAlchemy connection string.
# Uses the Docker service name "postgres" as the host — never localhost.
DATABASE_URL=postgresql+asyncpg://platform_user:platform_pass@postgres:5432/platform_db

# Runtime environment label: development | staging | production
APP_ENV=development

# Minimum log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Host port to expose the FastAPI application on the Docker host (default: 8000)
BACKEND_PORT=8000

# ── JWT Authentication ─────────────────────────────────────────────────────────

# Secret key used to sign JWT tokens.
# Generate a strong random value for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_in_production_use_a_long_random_string

# Algorithm used to sign JWTs (RS256 recommended for production; HS256 for dev)
JWT_ALGORITHM=HS256

# How many minutes a JWT access token remains valid before expiring
JWT_EXPIRE_MINUTES=60

# ── CORS ───────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins for cross-origin requests.
# For production, list only the exact frontend domains.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Kafka Messaging ─────────────────────────────────────────────────────────────

# Kafka bootstrap servers (service name 'kafka:9092' inside Docker, 'localhost:9093' from host)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=pipeline-platform
KAFKA_DEFAULT_PARTITIONS=3
KAFKA_DEFAULT_REPLICATION_FACTOR=1
KAFKA_PRODUCER_ACKS=all
KAFKA_CONSUMER_GROUP_PREFIX=pipeline-group

# ── Spark ──────────────────────────────────────────────────────────────────────

# URL of the Spark master (service name inside Docker, localhost:7077 from host)
SPARK_MASTER_URL=spark://spark-master:7077

# Absolute path where spark-jobs/ is mounted inside the backend container
SPARK_JOBS_PATH=/app/spark-jobs

# Timeout in seconds for spark-submit processes (default 300 = 5 minutes)
SPARK_SUBMIT_TIMEOUT_SECONDS=300

# ── HDFS (Phase 6) ─────────────────────────────────────────────────────────────

# WebHDFS base URL of the NameNode (service name inside Docker; localhost:9870 from host)
HDFS_NAMENODE_URL=http://namenode:9870

# Hadoop username for SIMPLE authentication (matches bde2020 image default)
HDFS_USER=root

# Replication factor for files written to HDFS (1 for single-datanode local dev)
HDFS_DEFAULT_REPLICATION=1

# ── Airflow (Phase 6) ──────────────────────────────────────────────────────────

# AIRFLOW_UID must match the UID of the host user running docker-compose on
# Linux/macOS so volume-mounted files have the correct ownership inside the
# Airflow containers.  Find your UID with:  id -u
# On Windows with Docker Desktop this is NOT required (the daemon manages it).
# Reference: https://airflow.apache.org/docs/apache-airflow/stable/howto/docker-compose/index.html
# AIRFLOW_UID=50000

# -- ChaosLab Reliability Engine (Phase 7) -------------------------------------

# Docker Compose project name � must match the actual project name used when
# running docker-compose (the directory name by default, or COMPOSE_PROJECT_NAME).
# SafetyValidator uses this to verify that target containers belong ONLY to this
# platform. Never point this at an external project name.
PROJECT_CONTAINER_PREFIX=resilient-big-data-platform

# -- Platform Monitoring (Grafana) -----------------------------------------------
# Grafana admin credentials. Change GRAFANA_ADMIN_PASSWORD before running.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(18))"
#
# IMPORTANT — Grafana volume behaviour:
#   Grafana reads GF_SECURITY_ADMIN_PASSWORD only on first boot; the value is then
#   stored inside the grafana_data Docker volume. To change an existing password:
#     1. docker compose down
#     2. docker volume rm <project>_platform_grafana_data  (export dashboards first!)
#     3. docker compose up
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# -- Platform Auth ---------------------------------------------------------------
# Used by POST /api/auth/login.
# REQUIRED in all environments. Backend fails fast if blank (non-dev mode) or
# set to any known placeholder (all modes). Generate a strong value:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-running