# .gitignore

# ── Environment / Secrets ──────────────────────────────────────────────────────
.env
*.env.local
*.env.production
*.env.staging

# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Testing ─────────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
playwright-report/
test-results/

# ── Type checking ──────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# ── IDE / Editor ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Docker ─────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Alembic ────────────────────────────────────────────────────────────────────
alembic.local.ini

# ── Node / Frontend ────────────────────────────────────────────────────────────
node_modules/

# ── Scratch / Temp ─────────────────────────────────────────────────────────────
scratch/
stream.log
*.log
*.tmp
*.bak

# generated by scripts/generate_sales_data.py (see README)
backend/sample-data/sales_large.csv
backend/sample-data/sales_300k.csv
sample-data/sales_large.csv
sample-data/sales_300k.csv

# ── Clean-up & Artifacts ───────────────────────────────────────────────────────
token.txt
*.token
/scratch*
/patch*.py
/new_*.txt
/old_*.txt
/tmp/
.pytest_cache/
*.parquet
# ── Scratch Evaluation Scripts ────────────────────────────────────────────────
scripts/evaluation/check_host_ram.py
scripts/evaluation/fix_schema.py
scripts/evaluation/get_host_mem_breakdown.py
scripts/evaluation/report_mem.ps1
scripts/evaluation/verify_preflight_standalone.py
