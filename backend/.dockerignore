# .dockerignore
# Exclude files that should never be copied into the Docker image.

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
.Python

# Virtual environments
.venv/
.venv-test/
venv/
env/

# Test artefacts
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Secrets / environment
.env
*.env.local

# Git
.git/
.gitignore

# Documentation build output
docs/_build/
site/

__pycache__/
*.pyc
.pytest_cache/
scratch/
*.log
.env

