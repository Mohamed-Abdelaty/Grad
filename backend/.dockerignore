# .dockerignore
# Exclude files that should never be copied into the Docker image.

# Python cache
__pycache__/
**/__pycache__
*.pyc
**/*.pyc
*.pyo
*.pyd
*.pdb
.Python

# Virtual environments
.venv/
.venv-test/
venv/
env/

# Test artefacts
.pytest_cache/
**/.pytest_cache
.coverage
htmlcov/
*.egg-info/
playwright-report/
test-results/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Secrets / environment
.env
*.env.local
token.txt

# Git
.git/
.gitignore

# Documentation build output
docs/_build/
site/

# Node / Frontend
node_modules/
dist/

# Scratch & logs
scratch*
*.log
tmp/
tmp
